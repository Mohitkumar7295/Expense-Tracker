# ========================================================
# BACKEND ENVIRONMENT VARIABLES (.env / Railway / Docker)
# ========================================================

# Server Port
PORT=8080

# 1. MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers (Java)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_tracker?retryWrites=true&w=majority

# 2. JWT Secret Key (HMAC-SHA256, minimum 256 bits / 64 hex characters)
# Generate a fresh 64-char hex string:
JWT_SECRET=your-256-bit-secret-key-here-minimum-64-characters-long

# 3. Email / SMTP Configuration (For dispatching 6-digit registration & login OTP)
# For Gmail: Turn on 2-Step Verification -> Go to Google Account -> Security -> App Passwords -> Create App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-16-char-app-password

# 4. CORS Allowed Origins (Frontend URLs permitted to call the backend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://expense-tracker-xi-lake.vercel.app

